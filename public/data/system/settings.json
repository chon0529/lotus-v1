{
  "schema": "lotus.settings.v1",
  "timezone": "Asia/Macau",
  "ui": {
    "theme": "dark",
    "sidebarCollapsed": false,
    "fontScale": "normal",
    "layoutDensity": "compact",
    "maxExpandedSourcesPerDomain": 3
  },
  "domains": {
    "A": {
      "title": "政府政策",
      "color": "#2f6f5e",
      "desktopTopLimit": 15,
      "mobileTopLimit": 3,
      "defaultRefreshMin": 30
    },
    "B": {
      "title": "AS Roma",
      "color": "#8f3f46",
      "desktopTopLimit": 15,
      "mobileTopLimit": 3,
      "defaultRefreshMin": 15,
      "translateTitle": true,
      "keepOriginalTitle": true,
      "blockOnTranslationFail": false
    },
    "C": {
      "title": "財經市場",
      "color": "#3f5f8f",
      "desktopTopLimit": 15,
      "mobileTopLimit": 3,
      "defaultRefreshMin": 30,
      "priceRefreshMinOpen": 10,
      "priceRefreshMinClosed": 60
    }
  },
  "sourceDefaults": {
    "enabled": true,
    "uiVisible": true,
    "manualRefreshAllowed": true,
    "priority": "P1"
  },
  "sourceOverrides": {
    "a_gcs": { "refreshMin": 30, "priority": "P0" },
    "a_tdm": { "refreshMin": 20, "priority": "P1" },
    "b_laroma24": { "refreshMin": 15, "priority": "P1" },
    "c_watchlist": { "refreshMin": 10, "priority": "P0" }
  }
}
